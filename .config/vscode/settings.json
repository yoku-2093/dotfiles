{
    "git.enableSmartCommit": true,
    "git.confirmSync": false,
    "git.autofetch": true,
    "remote.SSH.remotePlatform": {
        "*.gitpod.local": "linux",
        "*.gitpod.remote": "linux"
    },
    "workbench.tree.expandMode": "doubleClick",
    "explorer.confirmDelete": false,
    "git.openRepositoryInParentFolders": "never",
    "explorer.autoReveal": false,
    "claudeCode.allowDangerouslySkipPermissions": true,
    "claudeCode.environmentVariables": [],
    "files.autoSave": "afterDelay",
    "window.newWindowProfile": "Work",
    "window.openFilesInNewWindow": "on",
    "window.openFoldersInNewWindow": "on",
    "window.openWithoutArgumentsInNewWindow": "on",
    "security.workspace.trust.untrustedFiles": "open",
    "claudeCode.initialPermissionMode": "bypassPermissions",
    "chat.editor.claude.preferAgentHost": true,
    "claudeCode.preferredLocation": "sidebar",
    "chat.agents.claude.preferAgentHost": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "github.copilot.chat.claudeAgent.allowAutoPermissions": true,
    "redhat.telemetry.enabled": true,
    "workbench.editor.enablePreview": false,
    "chat.permissions.default": "autoApprove",
    "github.copilot.chat.claudeAgent.allowDangerouslySkipPermissions": true,
    "claudeCode.archiveInactiveSessions": 0,
    "claudeCode.enableReopenClosedSessionShortcut": false,
    "chatgpt.cliExecutable": "",
    "githubPullRequests.pullBranch": "never",
    "aws.cloudformation.telemetry.enabled": false,
    "claudeCode.hideOnboarding": true
}